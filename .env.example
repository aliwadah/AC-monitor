# === Battery source: solar.siseli.com (Siseli) ===
SISELI_USER=
SISELI_PASSWORD=
SISELI_DEVICE_ID=

# === AC control: TCL Home app ===
TCL_USER=
TCL_PASSWORD=
TCL_AC_NICKNAME=

# === Battery safety threshold (%): refuse ON below this ===
ON_THRESHOLD=50

# === Optional: which interface/port the local server binds ===
# HOST=0.0.0.0
# PORT=8000